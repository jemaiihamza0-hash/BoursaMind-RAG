# BoursaMind-RAG standalone service
# No value below is a live secret.

BOURSAMIND_RAG_ENVIRONMENT=development
BOURSAMIND_RAG_DEBUG=true
BOURSAMIND_RAG_DATABASE_URL=sqlite:///./var/boursamind_rag.db
BOURSAMIND_RAG_VECTOR_BACKEND=json
BOURSAMIND_RAG_REDIS_URL=

# Authentication
# BoursaMind should use this through BOURSAMIND_RAG_API_KEY on its side.
BOURSAMIND_RAG_BOOTSTRAP_API_KEY=dev-boursamind-rag-key
BOURSAMIND_RAG_BOOTSTRAP_TENANT_SLUG=boursamind
BOURSAMIND_RAG_BOOTSTRAP_TENANT_NAME=BoursaMind
# Set to enable POST /v1/tenants for operator-driven tenant creation.
BOURSAMIND_RAG_ADMIN_KEY=

# Providers
BOURSAMIND_RAG_EMBEDDING_PROVIDER=auto
BOURSAMIND_RAG_OPENAI_API_KEY=
BOURSAMIND_RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BOURSAMIND_RAG_OPENAI_CHAT_MODEL=gpt-4o-mini
BOURSAMIND_RAG_LLM_PROVIDER=deterministic
BOURSAMIND_RAG_EMBEDDING_DIM=1536
BOURSAMIND_RAG_OPENAI_DAILY_TOKEN_BUDGET=0

# Authoritative BoursaMind data bridge. Both values are deployment secrets and
# intentionally blank in this example. The bridge is disabled unless both are set.
BOURSAMIND_RAG_BOURSAMIND_API_URL=http://127.0.0.1:8000
BOURSAMIND_RAG_BOURSAMIND_SERVICE_KEY=

# External public data sources (no API keys required)
BOURSAMIND_RAG_INS_BASE_URL=http://dataportal.ins.tn
# INS publishes multiple products; set only after confirming the documented path.
BOURSAMIND_RAG_INS_QUERY_PATH=
BOURSAMIND_RAG_INS_INDICATOR=
BOURSAMIND_RAG_GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
BOURSAMIND_RAG_EXTERNAL_HTTP_TIMEOUT_SECONDS=15
BOURSAMIND_RAG_EXTERNAL_HTTP_MAX_RETRIES=2

# Meta Graph API (Page credentials are local-only; never commit .env).
BOURSAMIND_RAG_META_GRAPH_BASE_URL=https://graph.facebook.com
BOURSAMIND_RAG_META_GRAPH_VERSION=v26.0
BOURSAMIND_RAG_META_PAGE_ID=
BOURSAMIND_RAG_META_PAGE_ACCESS_TOKEN=
BOURSAMIND_RAG_META_GRANTED_PERMISSIONS=pages_show_list,business_management,public_profile

# Retrieval
BOURSAMIND_RAG_CHUNK_TARGET_TOKENS=700
BOURSAMIND_RAG_CHUNK_OVERLAP_TOKENS=120
BOURSAMIND_RAG_CHUNK_MIN_TOKENS=80
BOURSAMIND_RAG_DEFAULT_TOP_K=5
BOURSAMIND_RAG_MAX_TOP_K=50
BOURSAMIND_RAG_MIN_RELEVANCE=0.22
BOURSAMIND_RAG_MAX_CONTEXT_CHARS=12000

# Uploads
BOURSAMIND_RAG_MAX_UPLOAD_BYTES=10485760
BOURSAMIND_RAG_ALLOWED_FILE_EXTENSIONS=txt,md,pdf
