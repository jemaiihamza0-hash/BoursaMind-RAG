# BoursaMind-RAG production environment template.
# Copy to a protected .env.production file outside version control and replace every
# REQUIRED_SECRET placeholder with a generated, unique secret. Never use these values.

# Immutable image reference REQUIRED for docker-compose.prod.yml.
BOURSAMIND_RAG_IMAGE=registry.example.com/boursamind-rag:REPLACE_WITH_IMMUTABLE_TAG
BOURSAMIND_RAG_PORT=8001

# PostgreSQL (REQUIRED_SECRET: use a dedicated, strong database password).
BOURSAMIND_RAG_POSTGRES_USER=boursamind_rag
BOURSAMIND_RAG_POSTGRES_PASSWORD=REQUIRED_SECRET_REPLACE_WITH_STRONG_POSTGRES_PASSWORD
BOURSAMIND_RAG_POSTGRES_DB=boursamind_rag

# Runtime safety. The production Compose file enforces these values.
BOURSAMIND_RAG_ENVIRONMENT=production
BOURSAMIND_RAG_DEBUG=false
BOURSAMIND_RAG_DATABASE_URL=postgresql+psycopg2://boursamind_rag:REQUIRED_SECRET_REPLACE_WITH_STRONG_POSTGRES_PASSWORD@rag-postgres:5432/boursamind_rag
BOURSAMIND_RAG_DATABASE_POOL_SIZE=4
BOURSAMIND_RAG_DATABASE_MAX_OVERFLOW=1
BOURSAMIND_RAG_DATABASE_POOL_TIMEOUT_SECONDS=30
BOURSAMIND_RAG_DATABASE_POOL_RECYCLE_SECONDS=1800
BOURSAMIND_RAG_DATABASE_CONNECT_TIMEOUT_SECONDS=10
BOURSAMIND_RAG_VECTOR_BACKEND=database
BOURSAMIND_RAG_RETRIEVAL_CANDIDATE_POOL=600
BOURSAMIND_RAG_CREATE_TABLES_ON_STARTUP=false
BOURSAMIND_RAG_REDIS_URL=
BOURSAMIND_RAG_LOG_LEVEL=INFO

# API authentication (all three are REQUIRED_SECRET and must be distinct).
# Bootstrap key: supplied by BoursaMind as BOURSAMIND_RAG_API_KEY.
BOURSAMIND_RAG_BOOTSTRAP_API_KEY=REQUIRED_SECRET_REPLACE_WITH_GENERATED_BOOTSTRAP_KEY
# Admin key: protects tenant administration endpoints.
BOURSAMIND_RAG_ADMIN_KEY=REQUIRED_SECRET_REPLACE_WITH_GENERATED_ADMIN_KEY
# Service key: authenticates RAG-to-BoursaMind internal calls.
BOURSAMIND_RAG_BOURSAMIND_SERVICE_KEY=REQUIRED_SECRET_REPLACE_WITH_GENERATED_SERVICE_KEY
BOURSAMIND_RAG_API_KEY_HEADER=X-BoursaMind-RAG-Key
BOURSAMIND_RAG_COMPATIBILITY_API_KEY_HEADER=X-BoursaMind-Key
BOURSAMIND_RAG_ADMIN_KEY_HEADER=X-BoursaMind-RAG-Admin-Key
BOURSAMIND_RAG_BOOTSTRAP_TENANT_SLUG=boursamind
BOURSAMIND_RAG_BOOTSTRAP_TENANT_NAME=BoursaMind
BOURSAMIND_RAG_DEFAULT_WORKSPACE_NAME=Default Workspace
BOURSAMIND_RAG_DEFAULT_COLLECTION_NAME=Default Collection

# Internal service URL. It must resolve on the shared boursamind-internal network.
BOURSAMIND_RAG_BOURSAMIND_API_URL=http://backend:8000
BOURSAMIND_RAG_BOURSAMIND_API_TIMEOUT_SECONDS=5

# OpenAI is optional. Leave the key blank when using deterministic providers.
# REQUIRED_SECRET only when EMBEDDING_PROVIDER or LLM_PROVIDER uses OpenAI.
BOURSAMIND_RAG_OPENAI_API_KEY=
BOURSAMIND_RAG_EMBEDDING_PROVIDER=deterministic
BOURSAMIND_RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BOURSAMIND_RAG_OPENAI_CHAT_MODEL=gpt-4o-mini
BOURSAMIND_RAG_LLM_PROVIDER=deterministic
BOURSAMIND_RAG_EMBEDDING_DIM=1536
BOURSAMIND_RAG_OPENAI_DAILY_TOKEN_BUDGET=0

# Retrieval and uploads.
BOURSAMIND_RAG_CHUNK_TARGET_TOKENS=700
BOURSAMIND_RAG_CHUNK_OVERLAP_TOKENS=120
BOURSAMIND_RAG_CHUNK_MIN_TOKENS=80
BOURSAMIND_RAG_DEFAULT_TOP_K=5
BOURSAMIND_RAG_MAX_TOP_K=50
BOURSAMIND_RAG_MIN_RELEVANCE=0.22
BOURSAMIND_RAG_MAX_CONTEXT_CHARS=12000
BOURSAMIND_RAG_MAX_UPLOAD_BYTES=10485760
BOURSAMIND_RAG_ALLOWED_FILE_EXTENSIONS=txt,md,pdf

# Public external-data settings. Meta credentials are optional and should remain
# blank until that integration is intentionally enabled.
BOURSAMIND_RAG_INS_BASE_URL=https://catalog.data.gov.tn
BOURSAMIND_RAG_INS_QUERY_PATH=fr/api/3/action/datastore_search
BOURSAMIND_RAG_INS_INDICATOR=population_kelibia_2004_2014
BOURSAMIND_RAG_INS_RESOURCE_ID=f1c31070-d2dc-429d-a5bf-31cedd4768dd
BOURSAMIND_RAG_INS_LIMIT=5
BOURSAMIND_RAG_GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
BOURSAMIND_RAG_META_GRAPH_BASE_URL=https://graph.facebook.com
BOURSAMIND_RAG_META_GRAPH_VERSION=v26.0
BOURSAMIND_RAG_META_PAGE_ID=
BOURSAMIND_RAG_META_PAGE_ACCESS_TOKEN=
BOURSAMIND_RAG_META_USER_ACCESS_TOKEN=
BOURSAMIND_RAG_META_GRANTED_PERMISSIONS=pages_show_list,business_management,public_profile
BOURSAMIND_RAG_EXTERNAL_HTTP_TIMEOUT_SECONDS=15
BOURSAMIND_RAG_EXTERNAL_HTTP_MAX_RETRIES=2
BOURSAMIND_RAG_GDELT_DEFAULT_TIMESPAN=7d
BOURSAMIND_RAG_GDELT_DEFAULT_MAXRECORDS=50
