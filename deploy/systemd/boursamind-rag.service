[Unit]
Description=BoursaMind-RAG standalone FastAPI service
Documentation=https://github.com/jemaiihamza0-hash/BoursaMind-RAG
Wants=network-online.target
After=network-online.target
ConditionPathExists=/www/wwwroot/BoursaMind-RAG/.venv/bin/python
ConditionPathExists=/www/wwwroot/BoursaMind-RAG/app/main.py
ConditionPathExists=/etc/boursamind/rag.env

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/BoursaMind-RAG
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BOURSAMIND_RAG_SKIP_DOTENV=1
EnvironmentFile=/etc/boursamind/rag.env
UMask=0077
ExecStartPre=/www/wwwroot/BoursaMind-RAG/.venv/bin/python -m app.production_preflight
ExecStart=/www/wwwroot/BoursaMind-RAG/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
MemoryMax=1G
TasksMax=512
StandardOutput=journal
StandardError=journal
SyslogIdentifier=boursamind-rag
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
